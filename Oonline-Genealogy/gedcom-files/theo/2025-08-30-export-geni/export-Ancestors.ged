1 NOTE {geni:about_me} 
2 CONT Male
2 CONT Edwardus Starbuck
2 CONT 1603–1690	 • 	LC7G-RVY​​
2 CONT
2 CONT Life Sketch
2 CONT
2 CONT Edward Starbuck was born about 1603 in Derbyshire, England. His father was also Edward Starbuck. He married Katherine Reynolds about 1630 in Derbyshire, England. He migrated to …   More
2 CONT
2 CONT
2 CONT Family Members
2 CONT
2 CONT Edwardus Starbuck
2 CONT 1603–1690	 • 	LC7G-RVY​​
2 CONT Marriage: 1625
2 CONT Dover, Strafford, New Hampshire, United States
2 CONT
2 CONT
2 CONT Catherine Eunice Reynolds
2 CONT 1609–1690	 • 	MW1H-VJ6​​
2 CONT
2 CONT Children of Catherine Eunice Reynolds and Edwardus Starbuck (10)
2 CONT
2 CONT Sarah Starbuck
2 CONT 1630–1713	 • 	LTM8-5MV​​
2 CONT
2 CONT Judith Starbuck
2 CONT 1635–1658	 • 	G67B-3PV​​
2 CONT
2 CONT Nathaniel Starbuck I
2 CONT 1636–1719	 • 	L29T-3PQ​​
2 CONT
2 CONT James Starbuck
2 CONT 1637–Deceased	 • 	L5VV-R13​​
2 CONT
2 CONT Dorcas Starbuck
2 CONT 1638–1696	 • 	LZ2N-QMQ​​
2 CONT
2 CONT Sarah Starbird
2 CONT 1638–1719	 • 	KJL8-M4Q​​
2 CONT
2 CONT Shuah Starbuck
2 CONT 1638–1685	 • 	LY39-JQC​​
2 CONT
2 CONT
2 CONT Abigail Starbuck
2 CONT 1641–1696	 • 	LZJB-T24​​
2 CONT
2 CONT Esther Starbuck
2 CONT 1644–1694	 • 	LC26-VQ2​​
